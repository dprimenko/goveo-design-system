{
  "$schema": "https://schemas.goveo.app/design-tokens.json",
  "meta": {
    "name": "Goveo Design System",
    "version": "1.0.0",
    "source": "dprimenko/goveo-astro"
  },
  "color": {
    "primary": {
      "50":  "#fff3f0",
      "100": "#ffe4dd",
      "200": "#ffc8bb",
      "300": "#ffa38e",
      "400": "#ff7d5e",
      "500": "#f96a3f",
      "600": "#f26134",
      "700": "#eb5a2c",
      "800": "#d44d23",
      "900": "#b33d1a",
      "950": "#7c2610"
    },
    "naranja": {
      "goveo": "#e98027",
      "dark":  "#d36d1d"
    },
    "neutral": {
      "100": "#f5f7f9",
      "200": "#e9e9eb",
      "300": "#c8cbce",
      "400": "#acaeb3",
      "500": "#8a8f94",
      "600": "#585b61",
      "700": "#585b61",
      "800": "#3b3f48",
      "900": "#292c32"
    },
    "zinc": {
      "400": "#a1a1aa",
      "500": "#71717a",
      "600": "#52525b",
      "700": "#3f3f46",
      "800": "#27272a",
      "900": "#18181b",
      "950": "#09090b"
    },
    "basic": {
      "white": "#ffffff",
      "black": "#000000"
    },
    "semantic": {
      "app": {
        "bg":           "#ffffff",
        "bgElevated":   "#f5f7f9",
        "bgOverlay":    "rgba(84,84,84,0.5)",
        "fg":           "#292c32",
        "fgMuted":      "#585b61",
        "fgSubtle":     "#acaeb3",
        "fgOnPrimary":  "#ffffff",
        "border":       "#e9e9eb",
        "borderStrong": "#c8cbce",
        "accent":       "#f96a3f",
        "accentHover":  "#eb5a2c"
      },
      "landing": {
        "bg":            "#09090b",
        "bgSoft":        "rgba(255,255,255,0.05)",
        "bgSection":     "rgba(24,24,27,0.40)",
        "border":        "rgba(255,255,255,0.10)",
        "borderStrong":  "rgba(255,255,255,0.20)",
        "fg":            "#ffffff",
        "fgMuted":       "#a1a1aa",
        "fgSubtle":      "#71717a",
        "accent":        "#e98027",
        "accentHover":   "#d36d1d"
      }
    }
  },
  "space": {
    "4":  4,
    "8":  8,
    "16": 16,
    "24": 24,
    "32": 32,
    "40": 40,
    "48": 48,
    "64": 64,
    "80": 80,
    "96": 96
  },
  "radius": {
    "4":      4,
    "8":      8,
    "16":     16,
    "24":     32,
    "pill":   9999,
    "cardXl":  48,
    "cardXxl": 56,
    "cardHero":64
  },
  "fontFamily": {
    "sans": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "fontWeight": {
    "regular":  400,
    "medium":   500,
    "semibold": 600,
    "bold":     700,
    "extra":    800,
    "black":    900
  },
  "type": {
    "display1":  { "size": 40, "lineHeight": 48 },
    "display2":  { "size": 32, "lineHeight": 40 },
    "display3":  { "size": 24, "lineHeight": 32 },
    "heading":   { "size": 20, "lineHeight": 24 },
    "body":      { "size": 16, "lineHeight": 24 },
    "bodySmall": { "size": 14, "lineHeight": 20 },
    "caption":   { "size": 12, "lineHeight": 16 }
  },
  "breakpoint": {
    "mobileXs":  375,
    "mobile":    480,
    "mobileMax": 768,
    "tablet":    1024,
    "desktop":   1440
  },
  "shadow": {
    "app":        "0 1px 2px rgba(0,0,0,0.06)",
    "orangeGlow": "0 0 50px rgba(233,128,39,0.15)",
    "orangeCta":  "0 4px 15px rgba(233,128,39,0.4)",
    "platinum":   "0 0 60px rgba(233,128,39,0.25)"
  },
  "textShadow": {
    "orangeGlow": "0 0 20px rgba(233,128,39,0.5)"
  },
  "zIndex": {
    "header":   8,
    "bottomBar":9,
    "modal":    10
  }
}
