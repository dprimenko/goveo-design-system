// src/pages/index.astro
// Landing principal — adaptada de landing-test.html al stack Astro+React+SCSS.
//
// Cambios respecto al HTML original:
//  - Tailwind CDN eliminado. Las utilidades inline ("text-4xl font-black italic …")
//    se han traducido a clases semánticas en SCSS que consumen los tokens del
//    design-system existente (_colors / _typography / _spacing / _border).
//  - Los iconos SVG inline pasan a `phosphor-astro` (mismo set que el resto del
//    proyecto, ya instalado en package.json).
//  - La lógica de tabs + modal + WhatsApp + descarga de imagen se mantiene en
//    vanilla TS dentro de un `<script>` no-inline (Astro lo bundlea solo).
//  - Las URLs de Stripe y los precios se exponen como `const` arriba para que
//    sean fáciles de tocar sin entrar en el markup.
//
// Para usarlo: copia este archivo a `src/pages/index.astro` en goveo-astro.
// No requiere instalar nada nuevo.

import { Upload } from 'phosphor-astro';

const PLAN_URLS = {
	premium: {
		mensual:   'https://buy.stripe.com/cNiaEY7ZXgt6auc4VMdMI1f',
		semestral: 'https://buy.stripe.com/14A28sgwt4Ko31KcoedMI1j',
		anual:     'https://buy.stripe.com/9B65kE4NL90E6dW0FwdMI1m',
	},
	platinum: {
		mensual:   'https://buy.stripe.com/aFa8wQfsp5Os6dW2NEdMI1g',
		semestral: 'https://buy.stripe.com/28E7sM6VT2CgeKsewmdMI1k',
		anual:     'https://buy.stripe.com/6oU6oIfspekYfOw2NEdMI1n',
	},
	boost: {
		mensual:   'https://buy.stripe.com/fZu4gAgwt4Ko9q8gEudMI1i',
		semestral: 'https://buy.stripe.com/4gM3cw4NL0u859S1JAdMI1l',
		anual:     'https://buy.stripe.com/14A3cw9412Cg0TCgEudMI1o',
	},
};

const PRICING_DATA = {
	premium:  { m: 29,  s: 147, a: 243,  saveS: 'Ahorras 26€',  saveA: 'Ahorras 105€' },
	platinum: { m: 59,  s: 299, a: 495,  saveS: 'Ahorras 53€',  saveA: 'Ahorras 213€' },
	boost:    { m: 150, s: 765, a: 1260, saveS: 'Ahorras 135€', saveA: 'Ahorras 540€' },
};

const BANNER_BG = 'https://es.goveo.app/assets/img/bg/header-bg11-madrid-feb24.jpg';
const LOGO_NEW  = 'https://es.goveo.app/assets/img/logo-newgoveo.png';
