	<!-- ============ INTERACTIVITY ============ -->
	<script define:vars={{ PLAN_URLS, PRICING_DATA }}>
		// Pricing tabs ----------------------------------------------------------
		let currentTab = 'mensual';

		function updatePricing(tab) {
			currentTab = tab;
			document.querySelectorAll('[data-tab]').forEach((btn) => {
				const active = btn.dataset.tab === tab;
				btn.classList.toggle('tab--active', active);
				btn.setAttribute('aria-selected', String(active));
			});

			['premium', 'platinum', 'boost'].forEach((plan) => {
				const data = PRICING_DATA[plan];
				const key = tab === 'mensual' ? 'm' : tab === 'semestral' ? 's' : 'a';
				const price = data[key];
				const old = Math.round(price * 1.20);

				const priceEl = document.querySelector(`[data-price="${plan}"]`);
				if (priceEl) priceEl.textContent = `${price}€`;
				const oldEl = document.querySelector(`[data-old="${plan}"]`);
				if (oldEl) oldEl.textContent = `${old}€`;

				const saveEl = document.querySelector(`[data-save="${plan}"]`);
				if (saveEl) {
					if (tab === 'semestral')    { saveEl.textContent = data.saveS; saveEl.style.opacity = '1'; }
					else if (tab === 'anual')   { saveEl.textContent = data.saveA; saveEl.style.opacity = '1'; }
					else                        { saveEl.style.opacity = '0'; }
				}
			});
		}

		document.querySelectorAll('[data-tab]').forEach((btn) => {
			btn.addEventListener('click', () => updatePricing(btn.dataset.tab));
		});

		// Go to Stripe checkout -------------------------------------------------
		document.querySelectorAll('[data-go-plan]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const plan = btn.dataset.goPlan;
				const url = PLAN_URLS[plan]?.[currentTab];
				if (url) window.open(url, '_blank', 'noopener');
			});
		});

		// Free plan modal -------------------------------------------------------
		const modal = document.getElementById('free-plan-modal');
		document.querySelectorAll('[data-open-modal]').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				modal.hidden = false;
				modal.style.display = 'flex';
				document.body.style.overflow = 'hidden';
			});
		});
		modal.addEventListener('click', (e) => {
			if (e.target === modal) closeModal();
		});
		document.querySelectorAll('[data-close-modal]').forEach((btn) => {
			btn.addEventListener('click', closeModal);
		});
		function closeModal() {
			modal.style.display = 'none';
			modal.hidden = true;
			document.body.style.overflow = '';
		}

		// WhatsApp send ---------------------------------------------------------
		document.getElementById('whatsapp-send')?.addEventListener('click', () => {
			const phone = document.getElementById('whatsapp-phone').value.trim();
			if (!phone) { alert('Por favor introduce un teléfono'); return; }
			const text = encodeURIComponent(
				'Hola Goveo! Quiero empezar a subir mis GeoClips. ' +
				'1.- Descarga la aplicación GOVEO. ' +
				'2.- Regístrate como Usuario y Publisher. ' +
				'3.- Sube tu GeoClip (Video 30s geolocalizado).'
			);
			window.open(`https://api.whatsapp.com/send?phone=${phone}&text=${text}`, '_blank', 'noopener');
		});

		// Descarga de imagen promo ---------------------------------------------
		document.getElementById('download-promo')?.addEventListener('click', async (e) => {
			const btn = e.currentTarget;
			const url = btn.dataset.url;
			const filename = btn.dataset.filename || 'goveo.png';
			try {
				const res = await fetch(url);
				if (!res.ok) throw new Error('fetch failed');
				const blob = await res.blob();
				const blobUrl = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = blobUrl;
				a.download = filename;
				document.body.appendChild(a);
				a.click();
				setTimeout(() => {
					a.remove();
					URL.revokeObjectURL(blobUrl);
				}, 100);
			} catch {
				window.open(url, '_blank', 'noopener');
			}
		});
	</script>
</body>

